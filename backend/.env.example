# Server
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Puppeteer
PUPPETEER_HEADLESS=true
PUPPETEER_LAUNCH_TIMEOUT=30000
PUPPETEER_PAGE_TIMEOUT=15000

# Anti-bot delays (ms)
REQUEST_DELAY_MIN=50
REQUEST_DELAY_MAX=300

# Cache TTLs (seconds)
CACHE_TTL_LIVE_SCORES=30
CACHE_TTL_FINAL_SCORES=3600
CACHE_TTL_BOXSCORE_FINAL=21600
CACHE_TTL_SCHEDULE=86400
CACHE_TTL_PLAYER_LOG=300
CACHE_TTL_PLAYER_AVG=900
CACHE_TTL_TEAM=3600
CACHE_TTL_STANDINGS=300

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# NBA defaults
NBA_SEASON=2024-25
NBA_SEASON_TYPE=Regular Season

# Base de datos
# Desarrollo: SQLite (fichero local)
DB_CLIENT=better-sqlite3
DB_PATH=./data/nba.db
# Producción: PostgreSQL (descomentar y configurar)
# DB_CLIENT=pg
# DATABASE_URL=postgresql://user:password@localhost:5432/nba_stats

# Scheduler diario (cron expression)
# Por defecto: 08:00 UTC (03:00 ET) — cuando todos los partidos ya terminaron
SCRAPE_CRON=0 8 * * *
SCRAPE_ENABLED=true
